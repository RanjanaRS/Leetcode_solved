/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int sum=0;
    public boolean hasPathSum(TreeNode root, int tsum) {
        return dfs(root,tsum,sum)==1;
        
    }
    public int dfs(TreeNode root, int tsum,int sum)
    {
        if(root==null)
        {
            return 0;
        }
      else{
          sum=sum+root.val;
      }
     if(root.left==null && root.right==null)
     {
         if(sum==tsum)
        {
            return 1;
        }
        else{
            return 0;
        }
     }
       int left=dfs(root.left,tsum,sum);
       int right=dfs(root.right,tsum,sum);
       return Math.max(left,right);
       

    }
}

