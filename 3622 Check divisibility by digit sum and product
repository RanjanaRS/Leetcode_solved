class Solution {
    public boolean checkDivisibility(int n) {
        int num=n;
        int sum=0;
        int prod=1;
        while(n>0)
        {
           int digit=n%10;
            sum=sum+digit;
            prod=prod*digit;
            n=n/10;
        }
        int ans=sum+prod;
        if(num%ans==0)
        {
            return true;
        }
        else {
            return false;
        }
    }
}
