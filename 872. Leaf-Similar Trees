/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<Integer> list1=new ArrayList<>();
      List<Integer> list2=new ArrayList<>();
    public boolean leafSimilar(TreeNode root1, TreeNode root2) {
      dfs1(root1,list1);
      dfs2(root2,list2);
      if(list1.size()!=list2.size())
      {
        return false;
      }
      else if(list1.equals(list2))
      {
        return true;
      }
      else{
        return false;
      }
    }
    public List<Integer> dfs1(TreeNode root1, List<Integer> list1)
    {
        if(root1==null)
        {
              return list1;
        }
        if(root1.left==null && root1.right==null)
        {
            list1.add(root1.val);
        }
         dfs1( root1.left, list1);
          dfs1(root1.right,list1);
         return list1;
        
    }
     public List<Integer> dfs2(TreeNode root2, List<Integer> list2)
    {
         if(root2==null)
        {
              return list2;
        }
        if(root2.left==null && root2.right==null)
        {
            list2.add(root2.val);
        }
         dfs2(root2.left,  list2);
         dfs2(root2.right,  list2);
         return list2;
    }
}
