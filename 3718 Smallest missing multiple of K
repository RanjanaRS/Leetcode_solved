class Solution {
    public int missingMultiple(int[] nums, int k) {
       HashSet<Integer>ans=new HashSet<>();
       for(int i=0;i<nums.length;i++)
       {
          ans.add(nums[i]);
       } 
       int n=1*k;
       int j=2;
     if(!ans.contains(k))
        {
            return k;
        }
      else{
       while(ans.contains(n))
       {
         n=j*k;
         j++;
       }   
      }
       return n; 
    }
}
