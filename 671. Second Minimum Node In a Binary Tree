/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int findSecondMinimumValue(TreeNode root) {
        int small=root.val;
        int secsmall=root.val;
        Queue<TreeNode>queue=new LinkedList<>();
        queue.offer(root);
        while(!queue.isEmpty())
        {
            int size=queue.size();
            for(int i=0;i<size;i++)
            {
                TreeNode node=queue.poll();
                if(node.val>small)
                {
                   if(secsmall==small || node.val<secsmall)
                   {
                      secsmall=node.val;
                   }
                }
                if(node.left!=null)
                {
                    queue.add(node.left);
                }
                  if(node.right!=null)
                {
                    queue.add(node.right);
                }

            }
        }
      if(secsmall==small)
      {
        return -1;
      }
      else{
          return secsmall;
      }
    }
}
