class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        ArrayList<Integer>answer=new ArrayList<>();
        ArrayList<Integer>number=new ArrayList<>();
        Arrays.sort(nums);
        int min=nums[0];
        int max=nums[nums.length-1];
         int n=nums.length;
        for(int i=0;i<n;i++)
        {
            number.add(nums[i]);
        }
        for(int i=min;i<=max;i++)
        {
            if(!number.contains(i))
            {
                answer.add(i);
            }
        }
        return answer;
    }
}
